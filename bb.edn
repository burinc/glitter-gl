;; Babashka runner for glitter-gl — the OpenGL/3D-geometry extension of
;; glitter, ported from glimmer-gl.
;;   bb info               grouped task cheat-sheet (start here)
;;   bb test                run the unit suite (jolt -M:test)
;;   bb plasma               interactive demo: rotating primitive + plasma/stripes shader
;;   bb ripple                interactive demo: full-screen fragment shader, no mesh at all
;;   bb orbit                interactive demo: several solids orbiting, via app/reactive-area
;;   bb knot                   interactive demo: a (p,q) torus knot, generated geometry
;;   bb check                 headless sanity check: shader compiles, geometry buffers valid
;;   bb gl-area-smoke          live-GTK smoke: :gl-area construct/realize/render/resize
;;   bb smokes                  gl-area-smoke + check (CI-safe entry point, mirrors glitter's bb smokes)
;;   bb lint | lint:strict      clj-kondo over glitter-gl-authored code; :strict propagates findings
;;   bb lsp:format | lsp:format-check       clojure-lsp format (mutate | dry-run)
;;   bb lsp:clean-ns | lsp:clean-ns-check   clojure-lsp clean-ns (mutate | dry-run)
;;   bb lsp:diagnostics | lsp:check | lsp:fix   diagnostics | all dry-run checks | auto-fix
;;   bb verify                pre-commit gate: lint (report) + test (must pass)
;;   bb check:positional-args | :strict   find fns with 3+ positional args (report | strict)
;;   bb hooks:install | hooks:install:full | hooks:uninstall   git pre-commit hook
;;   bb demos:crop             crop docs/demos/plasma-*.gif to the GL pane -> docs/demos/pane/
;;   bb nrepl [port]           start a jolt nREPL server (default 7888)
;;   bb docs-sync [--no-push]  rebuild + mirror + deploy the docs site (maintainer-only)
;; NOTE: task bodies are EDN-parsed — no #"regex", @deref, or #(...) reader macros.
;; NOTE: every jolt task below shells out to `jolt -M:<alias>`, never the deps.edn
;; `jolt <task>` shorthand — the task form does not propagate its child process's
;; exit status (originally verified in glitter against jolt v0.6.3; reverified
;; against v0.7.23-10-gc50a3717 — see docs/guide/testing-and-tasks.md); `-M:<alias>` exits correctly.
{:min-bb-version "1.3.0"
 :tasks
 {:requires ([babashka.fs :as fs]
             [clojure.string :as str])

  info {:doc "Grouped task cheat-sheet (start here; easier to scan than `bb tasks`)"
        :task
        (let [esc (str (char 27) "[")
              col (fn [c s] (str esc c "m" s esc "0m"))
              hdr (fn [s] (println (str "\n" (col "35" (str "── " s " ──")))))
              row (fn [t d] (println (str "  " (col "36" (format "%-33s" (str "bb " t))) d)))]
          (println (col "1;35" "\nglitter-gl — OpenGL/3D geometry extension of glitter"))
          (hdr "Verify")
          (row "test" "run the unit suite (jolt -M:test)")
          (row "verify" "lint (report) + test (must pass) — pre-commit gate")
          (hdr "Run")
          (row "plasma" "interactive demo: rotating primitive + plasma/stripes shader")
          (row "ripple" "interactive demo: full-screen fragment shader, no mesh at all")
          (row "orbit" "interactive demo: several solids orbiting, via app/reactive-area")
          (row "knot" "interactive demo: a (p,q) torus knot, generated geometry")
          (row "check" "headless sanity check: shader compiles, geometry buffers valid")
          (hdr "Smoke (live GTK, exits non-zero on failure)")
          (row "gl-area-smoke" ":gl-area construct/realize/render/resize against real GTK")
          (row "smokes" "run every automated smoke/check in sequence; stops at first failure")
          (hdr "Quality — lint/format/checks")
          (row "lint" "clj-kondo over glitter-gl-authored code (report only)")
          (row "lint:strict" "bb lint, but exit non-zero if any findings")
          (row "lsp:format" "reformat all Clojure files (clojure-lsp)")
          (row "lsp:format-check" "check formatting — dry run")
          (row "lsp:clean-ns" "clean + organize ns forms (clojure-lsp)")
          (row "lsp:clean-ns-check" "check ns forms — dry run")
          (row "lsp:diagnostics" "clojure-lsp diagnostics")
          (row "lsp:check" "all LSP checks (format + clean-ns + diagnostics) — dry run")
          (row "lsp:fix" "auto-fix: format + clean-ns (mutating)")
          (row "check:positional-args" "find fns with 3+ positional args (report only)")
          (row "check:positional-args:strict" "bb check:positional-args, but exit non-zero if any found")
          (hdr "Git hooks")
          (row "hooks:install" "install FAST pre-commit hook (lint errors + format + clean-ns, ~2s)")
          (row "hooks:install:full" "install FULL pre-commit hook (+ unit tests, slower)")
          (row "hooks:uninstall" "remove the git pre-commit hook")
          (hdr "Demos")
          (row "record" "batch-record a demo GIF for every take (needs internal screen-grab CLI)")
          (row "demos:examples" "print the seven take ids as EDN (used by bb record)")
          (row "demos:crop" "crop docs/demos/plasma-*.gif to the GL pane -> docs/demos/pane/")
          (hdr "Dev")
          (row "nrepl [port]" "start a jolt nREPL server (default 7888)")
          (hdr "Docs")
          (row "docs-sync [--no-push]" "rebuild + mirror + deploy the docs site (maintainer-only)")
          (println (str "\n" (col "2" "first run: bb test, then bb plasma  ·  CI gate: bb test && bb smokes"))))}

  test {:doc "Run the unit suite"
        :task (shell "jolt" "-M:test")}

  plasma {:doc "Interactive demo: rotating primitive + plasma/stripes shader"
          :task (shell "jolt" "-M:plasma")}

  ripple {:doc "Interactive demo: full-screen fragment shader, no mesh at all"
          :task (shell "jolt" "-M:ripple")}

  orbit {:doc "Interactive demo: several solids orbiting, via app/reactive-area"
         :task (shell "jolt" "-M:orbit")}

  knot {:doc "Interactive demo: a (p,q) torus knot, generated geometry"
        :task (shell "jolt" "-M:knot")}

  check {:doc "Headless sanity check: shader compiles, geometry buffers valid"
         :task (shell "jolt" "-M:check")}

  gl-area-smoke {:doc "Live-GTK smoke: :gl-area construct/realize/render/resize"
                 :task (shell "jolt" "-M:gl-area-smoke")}

  ;; Considered adding ripple/orbit/knot here too: all three honour
  ;; GLITTER_GL_DEMO_QUIT_MS and exit cleanly under the same live-GTK
  ;; arrangement gl-area-smoke uses. Not added: none of the three calls
  ;; System/exit on failure (verified: grep "System/exit" across all
  ;; three returns nothing) — a broken shader or a bad mesh just prints
  ;; to stdout and the process still exits 0, so folding one in here
  ;; would not actually gate anything. gl-area-smoke.clj and check.clj
  ;; both assert and exit non-zero on failure; that is what makes them
  ;; usable as a smoke, and none of the three new examples do.
  smokes {:doc "Run every live-GTK smoke and headless check in sequence; stops at the first failure"
          :task (do (shell "jolt" "-M:gl-area-smoke")
                    (shell "jolt" "-M:check"))}

  lint {:doc "clj-kondo over glitter-gl-authored code (report only)"
        :task (shell {:continue true} "clj-kondo" "--lint" "src" "test" "examples")}

  lint:strict {:doc "bb lint, but exit non-zero if any findings"
               :task (shell "clj-kondo" "--lint" "src" "test" "examples")}

  lsp:format {:doc "Reformat all Clojure files (clojure-lsp)"
              :task (shell "clojure-lsp" "format")}

  lsp:format-check {:doc "Check formatting — dry run"
                    :task (shell "clojure-lsp" "format" "--dry")}

  lsp:clean-ns {:doc "Clean + organize ns forms (clojure-lsp)"
                :task (shell "clojure-lsp" "clean-ns")}

  lsp:clean-ns-check {:doc "Check ns forms — dry run"
                      :task (shell "clojure-lsp" "clean-ns" "--dry")}

  lsp:diagnostics {:doc "clojure-lsp diagnostics"
                   :task (shell "clojure-lsp" "diagnostics")}

  lsp:check {:doc "All LSP checks (format + clean-ns + diagnostics) — dry run"
             :task (do (shell "clojure-lsp" "format" "--dry")
                       (shell "clojure-lsp" "clean-ns" "--dry")
                       (shell "clojure-lsp" "diagnostics"))}

  lsp:fix {:doc "Auto-fix: format + clean-ns (mutating)"
           :task (do (shell "clojure-lsp" "format")
                     (shell "clojure-lsp" "clean-ns"))}

  verify {:doc "Pre-commit gate: lint (report) + test (must pass)"
          :task (do (shell {:continue true} "clj-kondo" "--lint" "src" "test" "examples")
                    (shell "jolt" "-M:test"))}

  check:positional-args {:doc "Find fns with 3+ positional args (prefer a kwargs map)"
                         :task (let [{:keys [exit]} (shell {:continue true} "bb" "scripts/check_positional_args.clj")]
                                 (System/exit exit))}

  check:positional-args:strict {:doc "check:positional-args, but fail (exit 1) if any found"
                                :task (let [{:keys [exit]} (shell {:continue true} "bb" "scripts/check_positional_args.clj" "--strict")]
                                        (System/exit exit))}

  hooks:install {:doc "Install FAST git pre-commit hook (lint errors + format + clean-ns, ~2s)"
                 :task (let [hook (str/trim (:out (shell {:out :string} "git" "rev-parse" "--git-path" "hooks/pre-commit")))]
                         (spit hook (str "#!/bin/bash\n"
                                         "# glitter-gl pre-commit (FAST — lint errors-only + format + clean-ns dry-run).\n"
                                         "# Full (+ test suite): bb hooks:install:full\n"
                                         "echo 'pre-commit 1/3: clj-kondo (errors only; known warnings accepted)'\n"
                                         "clj-kondo --lint src test examples\n"
                                         "LINT_EXIT=$?\n"
                                         "if [ \"$LINT_EXIT\" = \"3\" ]; then echo 'pre-commit: lint errors found'; exit 1; fi\n"
                                         "echo 'pre-commit 2/3: clojure-lsp format --dry'\n"
                                         "clojure-lsp format --dry || { echo 'run bb lsp:format'; exit 1; }\n"
                                         "echo 'pre-commit 3/3: clojure-lsp clean-ns --dry'\n"
                                         "clojure-lsp clean-ns --dry || { echo 'run bb lsp:clean-ns'; exit 1; }\n"
                                         "exit 0\n"))
                         (shell "chmod" "+x" hook)
                         (println "OK fast pre-commit hook installed")
                         (println ">> skip once with: git commit --no-verify"))}

  hooks:install:full {:doc "Install FULL git pre-commit hook (lint errors + format + clean-ns + unit tests, slower)"
                      :task (let [hook (str/trim (:out (shell {:out :string} "git" "rev-parse" "--git-path" "hooks/pre-commit")))]
                              (spit hook (str "#!/bin/bash\n"
                                              "# glitter-gl pre-commit (FULL). Fast: bb hooks:install\n"
                                              "echo 'pre-commit 1/4: clj-kondo (errors only; known warnings accepted)'\n"
                                              "clj-kondo --lint src test examples\n"
                                              "LINT_EXIT=$?\n"
                                              "if [ \"$LINT_EXIT\" = \"3\" ]; then echo 'pre-commit: lint errors found'; exit 1; fi\n"
                                              "echo 'pre-commit 2/4: clojure-lsp format --dry'\n"
                                              "clojure-lsp format --dry || { echo 'run bb lsp:format'; exit 1; }\n"
                                              "echo 'pre-commit 3/4: clojure-lsp clean-ns --dry'\n"
                                              "clojure-lsp clean-ns --dry || { echo 'run bb lsp:clean-ns'; exit 1; }\n"
                                              "echo 'pre-commit 4/4: unit tests'\n"
                                              "jolt -M:test\n"
                                              "exit $?\n"))
                              (shell "chmod" "+x" hook)
                              (println "OK full pre-commit hook installed")
                              (println ">> skip once with: git commit --no-verify"))}

  hooks:uninstall {:doc "Remove the git pre-commit hook"
                   :task (let [hook (str/trim (:out (shell {:out :string} "git" "rev-parse" "--git-path" "hooks/pre-commit")))]
                           (if (fs/exists? hook)
                             (do (fs/delete hook) (println "OK pre-commit hook removed"))
                             (println ">> no pre-commit hook found")))}

  ;; --- Demo GIFs ------------------------------------------------------------
  demos:examples
  {:doc "Print the demo item list as EDN for screen-grab (used by bb record)"
   :task
   ;; Each take launches ALREADY in the state it shows, via the demo's
   ;; GLITTER_GL_DEMO_SHAPE / _SMOOTH env vars, so no take needs a steering
   ;; timeline. Synthetic keystroke steering was measured and rejected: a
   ;; multi-step :key timeline skips widgets and toggles controls it never
   ;; touched (burinc/b12n-screen-grab#5). `env` is spelled out because
   ;; screen-grab spawns via p/process, which tokenizes without a shell —
   ;; a bare VAR=x prefix would be exec'd as a binary name.
   ;;
   ;; ripple/orbit/knot self-animate via :on-tick and take no env-var
   ;; variant, unlike plasma's four takes of one program — each gets its
   ;; own single-item group rather than joining "plasma" or each other.
   (prn (vec (concat
              (for [row [["plasma-cube"   "the default cube, rotating under the composable plasma/stripes shader" ""]
                         ["plasma-sphere" "the same shader on a sphere"                                           "GLITTER_GL_DEMO_SHAPE=sphere"]
                         ["plasma-tetra"  "the same shader on a tetrahedron"                                      "GLITTER_GL_DEMO_SHAPE=tetra"]
                         ["plasma-smooth" "smooth shading, against the flat shading of the takes above"           "GLITTER_GL_DEMO_SMOOTH=1"]]]
                {:id (nth row 0)
                 :group "plasma"
                 :desc (nth row 1)
                 :src "examples/glitter_gl/plasma.clj"
                 :run (if (= "" (nth row 2))
                        "jolt -M:plasma"
                        (str "env " (nth row 2) " jolt -M:plasma"))})
              [{:id "ripple"
                :group "ripple"
                :desc "a full-screen fragment shader, no mesh, no lighting, no camera"
                :src "examples/glitter_gl/ripple.clj"
                :run "jolt -M:ripple"}
               {:id "orbit"
                :group "orbit"
                :desc "six distinct solids orbiting above a ground plane, lit and shadowed, mounted via reactive-area"
                :src "examples/glitter_gl/orbit.clj"
                :run "jolt -M:orbit"}
               {:id "knot"
                :group "knot"
                :desc "a (2,3) trefoil torus knot generated from scratch, 2400 quads"
                :src "examples/glitter_gl/knot.clj"
                :run "jolt -M:knot"}])))}

  record
  {:doc "Batch-record a demo GIF for every take: bb record [--only a,b] [--force] [--dry-run]"
   ;; Maintainer-only. The capture CLI is not publicly released yet, and
   ;; recording takes the screen over for a few minutes. Contributors never
   ;; need it: every GIF is committed under docs/demos/.
   ;;
   ;; Ordering: this regenerates the full-window originals only. It never
   ;; touches docs/demos/pane/, so after any bb record run, follow up with
   ;; bb demos:crop to refresh the cropped gallery set too - otherwise
   ;; pane/ silently goes stale against the new originals.
   :task (if-not (fs/which "screen-grab")
           (binding [*out* *err*]
             (println "bb record needs the `screen-grab` capture CLI on your PATH.")
             (println "That tool is internal and not publicly released yet, so this")
             (println "task is maintainer-only. You do not need it to view the demos:")
             (println "every GIF is committed under docs/demos/ - see docs/demos/README.md.")
             (System/exit 1))
           (let [{:keys [exit]} (apply shell {:continue true}
                                       "screen-grab" "record"
                                       "--manifest" "scripts/demo_manifest.edn"
                                       *command-line-args*)]
             (System/exit exit)))}

  demos:crop
  {:doc "Crop docs/demos/plasma-*.gif to the GL pane -> docs/demos/pane/ (for the guide's four-up gallery)"
   ;; The four-up gallery in docs/guide/examples.md does not want the full
   ;; window: the control panel (roughly the top two-thirds of the frame)
   ;; is identical across all four takes and is pure noise repeated four
   ;; times, while the actual subject, the rotating shaded solid, occupies
   ;; only the bottom third. This crops each source down to just the dark
   ;; GL pane and writes the result alongside, under pane/, leaving the
   ;; full-window originals untouched.
   ;;
   ;; The crop window was measured by hand on a 560x418 source
   ;; (docs/demos/plasma-sphere.gif, 2026-08-25, via `gifsicle --info` plus
   ;; a mid-frame extracted with ffmpeg): the dark pane begins at y=275
   ;; (275/418 = 0.6579, about 66% of the frame height) and runs 135px
   ;; down to just above the window's drop shadow (275+135=410, leaving an
   ;; 8px margin at the bottom). Both figures are kept as fractions of
   ;; height below, not raw pixels, and reapplied to each source's ACTUAL
   ;; height (read per file via `gifsicle --info`, not assumed to be 418),
   ;; so a future re-record at a different capture size still crops
   ;; correctly. If the demo's control-panel layout changes, re-derive:
   ;; extract a mid-animation frame (`ffmpeg -i docs/demos/plasma-cube.gif
   ;; -vf "select=eq(n\,20)" -update 1 -frames:v 1 /tmp/frame.png`), look
   ;; at it, read off the y pixel where the dark pane starts and ends, and
   ;; replace pane-y-frac / pane-h-frac below with the new ratios.
   ;;
   ;; gifsicle warns "too many colors, using local colormaps" on every
   ;; file here - that is it preserving the plasma gradient's fidelity via
   ;; a local colormap, not degrading it. Do not silence it with --colors;
   ;; palette reduction visibly bands the exact gradients this crop exists
   ;; to show.
   :task
   (let [pane-y-frac 0.6579
         pane-h-frac 0.3230
         src-dir "docs/demos"
         out-dir "docs/demos/pane"
         ids ["plasma-cube" "plasma-sphere" "plasma-tetra" "plasma-smooth"]]
     (fs/create-dirs out-dir)
     (doseq [id ids]
       (let [src (str src-dir "/" id ".gif")
             out (str out-dir "/" id ".gif")
             info (:out (shell {:out :string} "gifsicle" "--info" src))
             dims (re-find (re-pattern "logical screen (\\d+)x(\\d+)") info)
             w (nth dims 1)
             height (Integer/parseInt (nth dims 2))
             pane-y (int (Math/round (* height pane-y-frac)))
             pane-h (int (Math/round (* height pane-h-frac)))
             crop (str "0," pane-y "+" w "x" pane-h)]
         (println (str id ": " w "x" height " -> --crop " crop))
         (shell "gifsicle" "--crop" crop "--resize-width" "400" "-O3" src "-o" out)))
     (println (str "OK cropped " (count ids) " gif(s) -> " out-dir "/")))}

  nrepl {:doc "Start a jolt nREPL server for interactive dev: bb nrepl [port] (default 7888)"
         :task (shell "jolt" "nrepl-server" (or (first *command-line-args*) "7888"))}

  ;; --- Docs -----------------------------------------------------------------
  docs-sync
  {:doc "Republish the docs: rebuild, push the site repo, mirror the guide, deploy to S3 + CloudFront. Maintainer-only: needs private sibling repos and AWS_PROFILE=b12n. bb docs-sync [--no-push]"
   ;; Pages variant: GitHub serves docs/ straight from the site repo's main
   ;; branch, so there is no S3 sync and no CloudFront invalidation to do —
   ;; a push IS the deploy. Contrast b12n-raylib-clj's docs-sync, which
   ;; additionally pushes to S3 because that site is fronted by CloudFront.
   ;;
   ;; Never force-pushes and never rebases: if a target is behind, it says so
   ;; and stops. --no-push commits locally and publishes nothing.
   ;;
   ;; Do NOT commit docs/CNAME by hand. The b12n-docs engine writes it from
   ;; :cname in projects/glitter-gl.edn, and `bb site:build` wipes the output dir
   ;; first — a hand-placed one survives a single build, then vanishes and
   ;; takes the domain down with it.
   :task
   (let [push?     (not (some (fn [a] (= a "--no-push")) *command-line-args*))
         home      (System/getProperty "user.home")
         proj-dir  (System/getProperty "user.dir")
         docs-repo (str home "/dev/b12n-docs")
         site-repo (str home "/dev/glitter-gl.github.io")
         wiki-repo (str home "/dev/b12n-wikis")
         wiki-dir  (str wiki-repo "/glitter-gl")
         bucket    "b12n-site-glitter-gl"
         site-host "glitter-gl.b12n.app"
         hdr       (fn [label] (println (str "\n-- " label " --")))
         missing   (remove fs/exists? [docs-repo site-repo wiki-repo])
         dirty?    (fn [dir path]
                     (let [res (shell {:dir dir :out :string} "git" "status" "--short" "--" path)]
                       (not (str/blank? (:out res)))))
         ;; Returns a keyword rather than exiting, so one repo failing does not
         ;; block the other. add/commit are scoped to `path` — never -A/. —
         ;; because b12n-wikis is shared across many projects and a stray
         ;; staged file must not ride along.
         sync!     (fn [opts]
                     (let [label (:label opts) dir (:dir opts)
                           path (:path opts) msg (:msg opts)]
                       (hdr label)
                       (let [committed? (if (dirty? dir path)
                                          (do (shell {:dir dir} "git" "add" "--" path)
                                              (shell {:dir dir} "git" "commit" "-m" msg "--" path)
                                              true)
                                          false)]
                         (cond
                           (not push?)
                           (do (println (if committed?
                                          "  committed locally (--no-push)"
                                          "  nothing to commit (--no-push)"))
                               :ok)

                           :else
                           (do (shell {:dir dir :continue true} "git" "fetch" "origin")
                               (let [st (:out (shell {:dir dir :out :string}
                                                     "git" "status" "--short" "--branch"))]
                                 (if (str/includes? st "behind")
                                   (do (println "  SKIPPED — branch is behind origin. Pull and re-run.")
                                       :behind)
                                   (do (shell {:dir dir} "git" "push" "origin" "HEAD")
                                       (println (if committed? "  committed and pushed" "  pushed (already committed)"))
                                       :ok))))))))
         ;; Classify a failed head-bucket rather than assuming "no bucket".
         ;; It fails identically when the CLI cannot reach AWS at all, and on a
         ;; proxied laptop every aws call dies at the proxy while git keeps
         ;; working. Sending someone to tofu:apply for that would create
         ;; infrastructure that already exists.
         deploy!   (fn []
                     (hdr "deploy to S3 + CloudFront")
                     (cond
                       (not push?) (do (println "  skipped (--no-push publishes nothing outward)") :deploy-disabled)
                       (not (fs/which "aws")) (do (println "  SKIPPED - aws CLI not on PATH.") :aws-missing)
                       :else
                       (let [probe (shell {:continue true :out :string :err :string}
                                          "aws" "s3api" "head-bucket" "--bucket" bucket "--profile" "b12n")]
                         (if-not (zero? (:exit probe))
                           (let [err  (str/lower-case (str (:err probe) " " (:out probe)))
                                 said (first (str/split-lines (str/trim (str (:err probe) (:out probe)))))
                                 hit? (fn [ss] (some (fn [s] (str/includes? err s)) ss))]
                             (cond
                               (hit? ["proxy" "could not connect" "endpoint url" "name resolution"
                                      "network is unreachable" "timed out" "connection refused"])
                               (do (println "  SKIPPED - could not reach AWS at all. This is a network")
                                   (println "  problem on THIS MACHINE, not evidence the bucket is missing.")
                                   (println (str "    " said))
                                   :unreachable)

                               (hit? ["unable to locate credentials" "no credentials" "expired"
                                      "invalidclienttokenid" "sso session"])
                               (do (println "  SKIPPED - AWS credentials for profile b12n missing or expired.")
                                   (println (str "    " said))
                                   :credentials)

                               (hit? ["403" "forbidden" "accessdenied"])
                               (do (println (str "  SKIPPED - s3://" bucket " EXISTS but profile b12n cannot read it."))
                                   (println "  A permissions problem, not missing infrastructure.")
                                   :forbidden)

                               (hit? ["404" "not found" "nosuchbucket"])
                               (do (println (str "  SKIPPED - s3://" bucket " does not exist."))
                                   (println "  THIS is the one that needs infrastructure. Run once in ~/dev/b12n-infra:")
                                   (println "    bb render lock tofu:init tofu:plan tofu:apply -- static-site glitter-gl")
                                   :missing-bucket)

                               :else
                               (do (println "  SKIPPED - head-bucket failed for an unrecognized reason.")
                                   (println (str "    " said))
                                   :probe-failed)))
                           (let [sync-res (shell {:continue true} "aws" "s3" "sync"
                                                 (str site-repo "/docs/") (str "s3://" bucket "/")
                                                 "--profile" "b12n" "--delete")]
                             (if-not (zero? (:exit sync-res))
                               (do (println "  S3 SYNC FAILED") :sync-failed)
                               (let [q    (str "DistributionList.Items[?contains(Aliases.Items, `" site-host "`)].Id | [0]")
                                     dist (shell {:continue true :out :string} "aws" "cloudfront"
                                                 "list-distributions" "--profile" "b12n"
                                                 "--query" q "--output" "text")
                                     id   (str/trim (or (:out dist) ""))]
                                 (if (or (str/blank? id) (= id "None"))
                                   (do (println (str "  synced, but no CloudFront distribution found for " site-host))
                                       (println "  (cache not invalidated; the edge may serve stale files for a while)")
                                       :no-distribution)
                                   (let [inv (shell {:continue true} "aws" "cloudfront" "create-invalidation"
                                                    "--profile" "b12n" "--distribution-id" id "--paths" "/*")]
                                     (if (zero? (:exit inv))
                                       (do (println (str "  synced + invalidated (" id ") - https://" site-host)) :ok)
                                       (do (println "  synced, but INVALIDATION FAILED") :invalidation-failed)))))))))))]
     (if (seq missing)
       (do (println "Missing sibling repo(s):")
           (doseq [m missing] (println (str "  " m)))
           (System/exit 1))
       (do
         (hdr "rebuild")
         (shell {:dir docs-repo} "bb" "site:build" "glitter-gl")

         (hdr "mirror guide -> b12n-wikis")
         (doseq [f (fs/glob (str proj-dir "/docs/guide") "*.md")]
           (fs/copy f (fs/file wiki-dir (fs/file-name f)) {:replace-existing true}))
         (println (str "  copied " (count (fs/glob (str proj-dir "/docs/guide") "*.md")) " page(s)"))

         (let [a (sync! {:label "site repo" :dir site-repo :path "docs"
                         :msg "chore: rebuild docs"})
               b (sync! {:label "wiki mirror" :dir wiki-repo :path "glitter-gl"
                         :msg "glitter-gl: re-mirror guide pages"})
               c (deploy!)]
           (hdr "done")
           (println (str "  site repo:  " (name a)))
           (println (str "  wiki:       " (name b)))
           (println (str "  deploy:     " (name c)))
           ;; :skipped and :deploy-disabled are fine; anything else is not.
           (when-not (every? (fn [r] (contains? #{:ok :skipped :deploy-disabled} r)) [a b c])
             (System/exit 1))))))}}}
